# ========================================================
# NexusControl - Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS.
# NEVER COMMIT REAL KEYS OR THE .env FILE TO GIT!
# ========================================================

# Server Runtime
NODE_ENV=production
PORT=3000
APP_URL=https://my-admin.example.com

# --------------------------------------------------------
# Authentication & Security
# --------------------------------------------------------
# Secure 32+ character random string for HMAC-SHA256 session signatures
JWT_SECRET=replace_with_a_secure_random_64_char_hex_secret

# Default initial credentials for setup
DEFAULT_ADMIN_EMAIL=admin@nexus.internal
DEFAULT_ADMIN_PASSWORD=Admin@Nexus2026!
DEFAULT_USER_PASSWORD=NexusMember#2026

# --------------------------------------------------------
# Storage Configuration
# --------------------------------------------------------
# Active Storage Driver: "google-drive" | "local-disk" | "onedrive" | "dropbox"
ACTIVE_STORAGE_PROVIDER=local-disk

# Local filesystem storage path (used when provider is local-disk)
STORAGE_LOCAL_DIR=./data/storage

# Google Drive Storage Root Folder Name
GOOGLE_DRIVE_ROOT_FOLDER_NAME=AI-HOST
GOOGLE_DRIVE_ROOT_FOLDER_ID=root

# --------------------------------------------------------
# Google Drive API Option 1: Service Account (Recommended)
# --------------------------------------------------------
# In Google Cloud Console:
# 1. Enable "Google Drive API"
# 2. Create a Service Account -> Create Key -> JSON
# 3. Share your Google Drive "AI-HOST" folder with this email as Editor!
GOOGLE_SERVICE_ACCOUNT_EMAIL=nexus-drive-sa@your-gcp-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Alternatively, paste raw JSON string:
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"..."}'

# --------------------------------------------------------
# Google Drive API Option 2: OAuth2 Refresh Token (Personal Drive)
# --------------------------------------------------------
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REFRESH_TOKEN=1//04your-offline-refresh-token

# --------------------------------------------------------
# Optional: TeraBox 1TB Free Storage Adapter
# --------------------------------------------------------
# TeraBox has no official developer REST API. Connect via WebDAV bridge (Alist/Rclone)
# or session cookie:
# TERABOX_WEBDAV_URL=http://localhost:5244/dav/terabox
# TERABOX_WEBDAV_USER=admin
# TERABOX_WEBDAV_PASS=password
# TERABOX_NDUS_COOKIE=your-ndus-cookie

# --------------------------------------------------------
# Optional: S3 / Cloudflare R2 / Backblaze B2 (10GB Free + Zero Egress)
# --------------------------------------------------------
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=nexus-ai-storage

# --------------------------------------------------------
# Optional: Microsoft OneDrive / Dropbox
# --------------------------------------------------------
# ONEDRIVE_CLIENT_ID=
# ONEDRIVE_CLIENT_SECRET=
# ONEDRIVE_REFRESH_TOKEN=

# DROPBOX_APP_KEY=
# DROPBOX_APP_SECRET=
# DROPBOX_REFRESH_TOKEN=

# --------------------------------------------------------
# Optional AI Assistant Grounding
# --------------------------------------------------------
GEMINI_API_KEY=
